{
  "name": "keshbeker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "code:index": "node scripts/generate-code-map.mjs",
    "code:index:check": "node scripts/generate-code-map.mjs --check",
    "code:find": "node scripts/find-symbol.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "check": "npm run code:index:check && npm run lint && npm test"
  },
  "devDependencies": {
    "@babel/parser": "7.29.15",
    "@playwright/test": "1.65.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.16.0",
    "globals": "17.14.0",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
